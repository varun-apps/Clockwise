# ClockWise environment. Copy to .env. Every key below is REQUIRED — the app runs
# live-only and refuses to start if any is missing (no dummy-data fallback).

# --- LLM gateway (OpenAI-compatible, e.g. OpenRouter -> DeepSeek) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model ids consumed by llm/model-config.ts (safe defaults baked in code):
CLOCKWISE_MODEL_DEFAULT=deepseek/deepseek-chat
CLOCKWISE_MODEL_SYNTHESIS=deepseek/deepseek-chat
# Embedding model for cross-conversation semantic memory:
CLOCKWISE_EMBEDDING_MODEL=openai/text-embedding-3-small
CLOCKWISE_EMBEDDING_DIMS=1536

# --- Tool APIs (required; live data only) ---
AVIATIONSTACK_KEY=          # AviationStack — live flight search
TAVILY_KEY=                 # Tavily — live hotel search
OPENWEATHERMAP_KEY=         # OpenWeatherMap — live weather

# --- Database (app data + LangGraph checkpointer + memory store) ---
# Unset/empty => embedded PGlite + in-memory checkpointer/store (offline).
# Set to a Postgres URL to persist conversations, checkpoints, and memory.
DATABASE_URL=postgresql://clockwise:clockwise@localhost:5432/clockwise

# --- Langfuse observability (optional; unset => tracing is a no-op) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- App ---
CLOCKWISE_ENV=local
CLOCKWISE_LOG_LEVEL=info
CLOCKWISE_CORS_ORIGINS=http://localhost:5173
PORT=8000

