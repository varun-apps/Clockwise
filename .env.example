# ClockWise environment. Copy to .env. EVERY key is optional:
# when a key is absent the matching subsystem falls back to mock/no-op,
# so the whole stack runs offline with zero credentials.

# --- Database (used by app + LangGraph checkpointer) ---
# For local docker-compose Postgres:
DATABASE_URL=postgresql+psycopg://clockwise:clockwise@localhost:5432/clockwise

# --- LLM gateway (OpenAI-compatible, e.g. OpenRouter -> DeepSeek) ---
# Unset => gateway returns deterministic canned completions (mock mode).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model ids consumed by model_config.py (safe defaults baked in code):
CLOCKWISE_MODEL_DEFAULT=deepseek/deepseek-chat
CLOCKWISE_MODEL_SYNTHESIS=deepseek/deepseek-chat

# --- Tool APIs (Phase 3; unset => mock fixtures) ---
AVIATIONSTACK_KEY=
TAVILY_KEY=

# --- Langfuse observability (unset => tracing is a no-op) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- App ---
CLOCKWISE_ENV=local
CLOCKWISE_LOG_LEVEL=INFO
CLOCKWISE_CORS_ORIGINS=http://localhost:5173
